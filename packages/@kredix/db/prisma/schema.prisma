// =============================================================================
// Kredix — Schéma Prisma (PostgreSQL)
// =============================================================================
// Stack OSS auto-hébergée sur VPS (standard DEC-005).
// PostgreSQL + Prisma ORM : choix maturité / typage fort / migrations versionnées.
//
// Version 2 (session 11) : extension CRM complète.
//   - LeadStatus réconcilié (7 statuts pipeline) + SequenceExitReason
//   - Lead enrichi du moteur de prospection/relance (J+3/J+6/J+9, 6 sorties)
//   - Agent + AgentMemory (5 agents IA configurables, mémoire éditable)
//   - EmailTemplate (déclencheurs imposés : accusé/offre/relance 1-3/manuel)
//   - EmailGateway (multi-fournisseurs, 1 actif)
//   - SuppressionList (STOP/bounce/plainte — conformité anti-spam, sans IA)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS — Lead & prospection
// -----------------------------------------------------------------------------

/// Cycle de vie d'un lead dans le pipeline commercial (aligné sur le CRM : 7 statuts).
/// Les deux terminaux (client / lost) ferment la séquence de prospection.
enum LeadStatus {
  new         // Nouveau — formulaire rempli (orange)
  contacted   // Contacté — Agent Accueil a accusé réception (bleu clair)
  progress    // En analyse — dossier en traitement (bleu foncé)
  offer       // Offre envoyée (violet)
  waiting     // En relance — dans la file de relance (ambre)
  client      // Client — validé par admin (vert) — TERMINAL POSITIF
  lost        // Sans réponse / Clos — TERMINAL NÉGATIF (rouge)
}

/// Raison de sortie de la séquence de prospection.
/// Alimentée par : validation admin, lien de désinscription (token),
/// webhook fournisseur (bounce/plainte), exclusion manuelle, compteur, horloge.
/// L'IA ne lit JAMAIS les emails entrants — ces sorties sont systémiques.
enum SequenceExitReason {
  validated      // validé client par admin
  unsubscribe    // STOP du prospect (clic lien token)
  bounced        // email invalide (webhook fournisseur)
  complaint      // plainte / bouton spam (webhook fournisseur)
  excluded       // exclusion manuelle admin
  max_relances   // 3 relances atteintes
  timeout        // 10 jours sans validation admin
}

/// Niveau de permission des utilisateurs du back-office.
/// Zitadel gère l'authentification (SSO/OIDC), ce rôle local pilote l'autorisation.
enum AdminRole {
  admin    // accès complet (CMS + paramètres + utilisateurs)
  advisor  // conseiller : gère les leads qui lui sont assignés
  viewer   // lecture seule (reporting / audit)
}

// -----------------------------------------------------------------------------
// ENUMS — Agents IA
// -----------------------------------------------------------------------------

/// Rôles verrouillés des 5 agents IA. Un rôle = un agent (unique).
enum AgentRole {
  accueil   // accusé réception + annonce rappel 48h
  offre     // calcul et envoi de l'offre de prêt formalisée
  relance   // séquence de relance J+3 / J+6 / J+9
  tri       // qualification / priorisation des dossiers entrants
  seo       // audit référencement (lecture seule, suggestions)
}

// -----------------------------------------------------------------------------
// ENUMS — Emails
// -----------------------------------------------------------------------------

/// Déclencheur d'un modèle email. Verrouillé (enum fixe) pour garantir que le
/// job de relance trouve déterministiquement le bon template à chaque étape.
/// L'admin édite le CONTENU, jamais le slot.
enum EmailTrigger {
  reception_ack   // accusé Agent Accueil (J+0, <5 min)
  offer           // offre formalisée (Agent Offre)
  relance_1       // J+3 — IMPOSÉ
  relance_2       // J+6 — IMPOSÉ
  relance_3       // J+9 — IMPOSÉ
  manual          // envoi manuel (changement conseiller, etc.)
  level_1         // Niveau client 1 — Accueil client
  level_2         // Niveau client 2 — Demande documents
  level_3         // Niveau client 3 — Offre de prêt formelle
  level_4         // Niveau client 4 — Vérification dossier
  level_5         // Niveau client 5 — Accord de principe
  level_6         // Niveau client 6 — Signature
  level_7         // Niveau client 7 — Déblocage fonds
}

enum TemplateStatus {
  active
  draft
}

/// Fournisseurs d'envoi email. Un seul `isActive = true` à la fois (contrainte app).
enum GatewayProvider {
  resend
  brevo
  smtp
}

// -----------------------------------------------------------------------------
// ENUMS — Conformité anti-spam
// -----------------------------------------------------------------------------

/// Raison de présence en liste de suppression (ne plus jamais contacter).
enum SuppressionReason {
  unsubscribe   // STOP du prospect (clic lien token)
  bounce        // email invalide (webhook fournisseur)
  complaint     // plainte (bouton spam — webhook fournisseur)
  manual        // exclusion manuelle admin
}

// -----------------------------------------------------------------------------
// LEAD — demande de crédit déposée par un prospect + moteur de prospection
// -----------------------------------------------------------------------------
model Lead {
  id                String     @id @default(cuid())
  firstName         String
  lastName          String
  email             String?    // optionnel : le téléphone reste le canal principal
  phone             String
  city              String
  country           String     @default("FR") // code pays (FR, BE, CH, ...)

  // loanType en string (pas enum) : la liste de produits peut s'étendre
  // (véhicule, travaux, étudiant...) sans imposer une migration de schéma.
  loanType          String

  amount            Int        // montant demandé, en devise locale (entier = pas de flottants)
  durationYears     Int

  // Champs pré-calculés par le simulateur (instantané lead au moment de la demande).
  monthlyPayment    Int?       // mensualité estimée en euros
  annualRate        Float?     // taux indicatif en %
  totalCost         Int?       // coût total du crédit en euros

  // Même logique que loanType : situations professionnelles évolutives.
  employmentStatus  String

  status            LeadStatus @default(new)

  preferredLanguage String     @default("fr") // i18n des communications
  whatsappConsent   Boolean    @default(false) // consentement RGPD explicite
  notes             String?    // notes internes conseillers

  // Relation optionnelle : un lead peut ne pas encore être assigné.
  assignedToId      String?
  assignedTo        AdminUser? @relation("AssignedLeads", fields: [assignedToId], references: [id])

  // ===== MOTEUR DE PROSPECTION / RELANCE =====
  // L'Agent Accueil accuse réception (<5 min) puis annonce un rappel 48h.
  // Sans validation client, le lead entre en file de relance (J+3/J+6/J+9).
  // Sorties systémiques (jamais par lecture d'email entrant) :
  //   validation admin · STOP (lien token) · bounce/plainte (webhook fournisseur)
  //   exclusion manuelle · 3 relances · timeout 10 jours.
  ackSentAt         DateTime?    // accusé Agent Accueil envoyé (J+0)
  recallDueAt       DateTime?    // rappel annoncé à 48 h
  sequenceActive    Boolean      @default(false) // dans la file de relance ?
  relanceCount      Int          @default(0)     // 0 → 3
  nextRelanceAt     DateTime?    // J+3 / J+6 / J+9 (prochaine échéance)
  sequenceStartedAt DateTime?
  sequenceEndedAt   DateTime?
  exitReason        SequenceExitReason?          // null tant que la séquence est active

  // ===== DÉSINSCRIPTION PUBLIQUE (sans login) =====
  // Lien pied d'email : /api/unsubscribe?t=<unsubscribeToken>
  // Le prospect clique → route publique → SuppressionList + fermeture séquence.
  unsubscribeToken  String       @unique @default(cuid())
  unsubscribedAt    DateTime?

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  // Accès rapide par statut pour les tableaux de bord / files de traitement.
  @@index([status])
  // Recherche par conseiller + statut = requête la plus fréquente du BO.
  @@index([assignedToId, status])
  // Requête du job de relance : leads actifs dont l'échéance est atteinte.
  @@index([sequenceActive, nextRelanceAt])
  // Reporting des sorties de séquence.
  @@index([exitReason])
}

// -----------------------------------------------------------------------------
// BANKPARTNER — banques comparées sur le site
// -----------------------------------------------------------------------------
model BankPartner {
  id           String   @id @default(cuid())
  name         String   @unique
  slug         String   @unique // stable pour les URLs (pas l'id technique)
  logoUrl      String?
  apiEndpoint  String? // intégration future (webservices bancaires)
  contactEmail String?
  contactPhone String?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0) // tri CMS-manuel pour la page comparatif

  rates        Rate[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// RATE — taux indicatifs par banque / type de prêt / palier de montant
// -----------------------------------------------------------------------------
model Rate {
  id         String      @id @default(cuid())
  bankId     String
  bank       BankPartner @relation(fields: [bankId], references: [id])

  loanType   String

  amountMin  Int // palier bas (inclusif)
  amountMax  Int // palier haut (inclusif)

  annualRate Float // taux annuel en % (ex: 4.95)
  isActive   Boolean     @default(true)
  validFrom  DateTime    @default(now()) // date d'entrée en vigueur (historique)

  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  // Un même palier ne peut exister qu'une fois par banque/type : empêche les
  // doublons qui rendraient le comparatif ambigu.
  @@unique([bankId, loanType, amountMin, amountMax])
  // Recherche des taux applicables pour un type donné (page comparatif).
  @@index([loanType, isActive])
}

// -----------------------------------------------------------------------------
// ADMINUSER — comptes admin CRM (auth NextAuth.js v5 Credentials + bcrypt)
// -----------------------------------------------------------------------------
// NextAuth v5 (DEC-K4) remplace Zitadel. Authentification via Credentials
// Provider + bcrypt. `zitadelSubjectId` conservé nullable pour mémoire
// (si migration future vers IAM externe). `passwordHash` requis pour login.
// `twoFactorSecret` (TOTP base32) nullable — activé individuellement par admin.
model AdminUser {
  id               String       @id @default(cuid())
  email            String       @unique
  displayName      String
  role             AdminRole    @default(advisor)
  isActive         Boolean      @default(true)
  passwordHash     String?      // bcrypt hash (null = login désactivé / externe)
  twoFactorSecret  String?      // TOTP base32 secret (null = 2FA désactivée)
  zitadelSubjectId String?      @unique // legacy Zitadel — nullable depuis DEC-K4
  lastLoginAt      DateTime?

  // Deux relations distinctes sur Lead : l'assignment nominatif
  // ("AssignedLeads") et la collection générique back-referencée.
  leads            Lead[]       @relation("AssignedLeads")
  // (relation inverse Lead.assignedTo)

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([role, isActive])
}

// -----------------------------------------------------------------------------
// SETTING — paramètres globaux éditables via CMS / Settings
// -----------------------------------------------------------------------------
// Stocké en string : les settings sont hétérogènes (numéro de téléphone,
// booléen, JSON léger). Le parsing/validation est fait côté app selon la clé.
// Catégories : contact, legal, simulator, cms.*, seo.*, ai.*, cadence.
model Setting {
  id          String   @id @default(cuid())
  key         String   @unique // ex: 'whatsapp_number', 'cms_hero_title'
  value       String
  category    String   @default("general") // ex: 'contact', 'cms.hero', 'ai.model'
  description String?
  updatedAt   DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// AGENT — agents IA configurables (5 rôles verrouillés)
// -----------------------------------------------------------------------------
// Le systemPrompt est VERROUILLÉ (non contournable) : il contient le rôle,
// les limites strictes et le bloc SÉCURITÉ. L'admin ne peut pas le modifier —
// il ne fait qu'éditer la mémoire (AgentMemory) et les outils/garde-fous.
model Agent {
  id            String     @id @default(cuid())
  role          AgentRole  @unique           // 5 rôles verrouillés (un agent par rôle)
  name          String                       // "Agent Accueil"
  initials      String                       // "AA" (avatar CRM)
  description   String                       // sous-rôle affiché
  isActive      Boolean    @default(true)
  systemPrompt  String     @db.Text          // VERROUILLÉ (rôle + SÉCURITÉ)
  // tools : liste blanche d'outils par agent (on/off + description).
  // JSON car lecture groupée + toggles UI ; structure stable côté app.
  tools         Json       @default("{}")    // ex: { "read_dossier": {on:true, desc:"Lecture seule"} }
  // guardrails : limites appliquées automatiquement (debit_max, escalade_si...).
  guardrails    Json       @default("{}")    // ex: { "debit_max": "50 emails/heure" }
  memories      AgentMemory[]

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

// -----------------------------------------------------------------------------
// AGENTMEMORY — fichier mémoire éditable clé/valeur (par agent)
// -----------------------------------------------------------------------------
// Édité INLINE depuis l'admin (add/modify/delete clé par clé).
// Sous-modèle (pas JSON) : CRUD individuel propre + queryable.
model AgentMemory {
  id        String  @id @default(cuid())
  agentId   String
  agent     Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  key       String                     // delai_rappel, arguments_cles, canal_prefere...
  value     String  @db.Text           // valeur éditable (texte libre)
  @@index([agentId])
}

// -----------------------------------------------------------------------------
// EMAILTEMPLATE — modèles d'emails (déclencheurs imposés)
// -----------------------------------------------------------------------------
// 6 slots fixes (reception_ack, offer, relance_1/2/3, manual).
// Contrainte app : UN seul template `active` par trigger (vérifié au save).
// Le job de relance trouve déterministiquement le template de chaque étape.
model EmailTemplate {
  id            String         @id @default(cuid())
  name          String                          // "Accusé de réception (DE)"
  trigger       EmailTrigger                    // slot fixe (pilote l'affectation auto)
  language      String         @default("fr")   // langue du contenu (fr, de, en, es, pt, it)
  agentId       String?                         // agent émetteur (optionnel, info)
  status        TemplateStatus @default(draft)  // active / draft
  subject       String         @db.Text         // objet avec variables {{Prénom}}
  bodyText      String         @db.Text         // éditeur visuel (texte + variables)
  htmlContent   String?        @db.Text         // mode import HTML (optionnel)
  bannerEnabled Boolean        @default(true)   // bannière Kredix en en-tête
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  campaigns     Campaign[]

  @@index([trigger, status, language])   // un seul actif par trigger + langue
}

// -----------------------------------------------------------------------------
// EMAILGATEWAY — passerelles d'envoi (multi-fournisseurs, 1 actif)
// -----------------------------------------------------------------------------
// L'admin configure chaque fournisseur ; UN seul isActive à la fois.
// apiKey : secret — JAMAIS exposé côté client (serveur uniquement).
// config : hôte SMTP, domaine, mode API/SMTP, identifiant (JSON selon provider).
model EmailGateway {
  id          String           @id @default(cuid())
  provider    GatewayProvider
  label       String                          // "Resend", "SMTP Hostinger"
  apiKey      String?                          // secret — usage serveur uniquement
  config      Json             @default("{}") // domaine, hôte, mode, identifiant
  isActive    Boolean          @default(false) // UN seul actif à la fois (contrainte app)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([provider])
}

// -----------------------------------------------------------------------------
// SUPPRESSIONLIST — ne plus jamais contacter (conformité anti-spam)
// -----------------------------------------------------------------------------
// Alimentée SANS lecture d'email entrant :
//   - lien de désinscription token (GET /api/unsubscribe?t=...)
//   - webhook fournisseur (POST /api/webhooks/email — bounce/complaint)
//   - exclusion manuelle admin
// Couvre le cas récurrent : même email, plusieurs leads dans le temps.
model SuppressionList {
  id        String             @id @default(cuid())
  email     String
  reason    SuppressionReason
  leadId    String?                              // lead à l'origine (traçabilité)
  createdAt DateTime           @default(now())

  @@unique([email])            // un email = une entrée (raison la plus récente)
  @@index([reason])
}

// -----------------------------------------------------------------------------
// LEGALPAGE — pages légales éditables depuis le CMS (CGU, mentions, RGPD...)
// -----------------------------------------------------------------------------
// Contenu long structuré avec sa propre route frontend /[locale]/legal/[slug].
// L'admin édite le contenu HTML via un éditeur riche dans le CRM.
model LegalPage {
  id        String   @id @default(cuid())
  slug      String   @unique    // "cgu", "mentions-legales", "politique-confidentialite"
  title     String               // "Conditions Générales d'Utilisation"
  category  String               // "legal" | "privacy" | "terms"
  content   String   @db.Text    // contenu HTML (éditeur riche)
  order     Int      @default(0) // ordre d'affichage dans le footer
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([category, isActive])
  @@index([order])
}

// -----------------------------------------------------------------------------
// CAMPAIGN — campagne d'envoi en masse (broadcast)
// -----------------------------------------------------------------------------
// L'admin crée une campagne (template + destinataires), puis déclenche l'envoi.
// Le traitement est asynchrone : 1 email → pause 30-90s → suivant → ...
// Respecte les garde-fous cadence (daily cap, intervalle, SuppressionList).
model Campaign {
  id              String         @id @default(cuid())
  name            String                          // "Offre spéciale été"
  templateId      String
  template        EmailTemplate  @relation(fields: [templateId], references: [id])
  status          CampaignStatus @default(draft)
  recipientSource String                          // "validated_today" | "validated_week" | "manual" | "all_active"
  totalRecipients Int            @default(0)
  sentCount       Int            @default(0)
  failedCount     Int            @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  recipients      CampaignRecipient[]

  @@index([status])
  @@index([createdAt])
}

model CampaignRecipient {
  id          String                  @id @default(cuid())
  campaignId  String
  campaign    Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId      String?
  email       String
  firstName   String?
  lastName    String?
  status      CampaignRecipientStatus @default(pending)
  sentAt      DateTime?
  error       String?

  @@index([campaignId, status])
}

enum CampaignStatus {
  draft       // créée, pas encore envoyée
  sending     // envoi en cours (processus async)
  completed   // terminée (tous les destinataires traités)
  cancelled   // annulée par l'admin
  failed      // erreur fatale
}

enum CampaignRecipientStatus {
  pending   // en attente d'envoi
  sent      // envoyé avec succès
  failed    // échec d'envoi (erreur gateway)
  skipped   // ignoré (suppression list, pas d'email)
}

// -----------------------------------------------------------------------------
// EMAILLOG — historique de tous les emails envoyés à un prospect
// -----------------------------------------------------------------------------
// Trace chaque envoi (accueil, offre, relance, campagne) pour audit + vue Historique.
model EmailLog {
  id           String   @id @default(cuid())
  leadId       String?                          // null si pas lié à un lead (campaign sans lead)
  email        String                           // snapshot email au moment de l'envoi
  trigger      String                           // "accueil_ack" | "offer" | "relance_1" | "relance_2" | "relance_3" | "campaign" | "manual"
  templateName String                           // "Accusé de réception" (snapshot du nom au moment de l'envoi)
  subject      String         @db.Text          // objet envoyé (après interpolation ou génération IA)
  bodyText     String?        @db.Text          // corps envoyé (snapshot — pour historique communication et contexte IA)
  campaignId   String?                          // si lié à une campagne
  status       String         @default("sent")  // "sent" | "failed" | "skipped"
  error        String?
  sentAt       DateTime       @default(now())

  @@index([leadId, sentAt])
  @@index([email, sentAt])
  @@index([trigger])
}

// -----------------------------------------------------------------------------
// DOMAIN — multi-domaines / multi-marques
// -----------------------------------------------------------------------------
// Permet de configurer plusieurs domaines pour des usages spécifiques :
// site public, admin CRM, envoi d'emails, ou marque blanche.
model Domain {
  id          String   @id @default(cuid())
  domain      String   @unique                 // "kredix.fr", "crm.kredix.fr", "moncredit.fr"
  type        DomainType @default(site)
  brandName   String?                           // nom de marque affiché (null = utiliser site_name)
  logoUrl     String?                           // logo spécifique à ce domaine
  primaryColor String?                          // couleur principale (hex), null = défaut
  isActive    Boolean  @default(true)
  isPrimary   Boolean  @default(false)          // un seul primaire par type
  sslStatus   String   @default("pending")      // "pending" | "active" | "error"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type, isActive])
}

enum DomainType {
  site     // site public principal
  admin    // interface admin CRM
  mail     // domaine d'envoi d'emails (SPF/DKIM/DMARC)
  brand    // marque blanche / domaine secondaire
}

// -----------------------------------------------------------------------------
// CLIENTSTEP — progression du client dans les 7 niveaux d'accompagnement
// -----------------------------------------------------------------------------
// Quand un prospect est validé comme client, il entre dans le parcours 7 niveaux.
// Chaque niveau déclenche l'envoi d'un email (template level_N) + PDFs associés.
model ClientStep {
  id          String   @id @default(cuid())
  leadId      String
  level       Int                             // 1 à 7
  templateId  String                          // template email envoyé à ce niveau
  emailLogId  String?                         // lien vers EmailLog
  sentAt      DateTime @default(now())

  @@unique([leadId, level])  // un seul envoi par niveau par client
  @@index([leadId])
}

// -----------------------------------------------------------------------------
// DOCUMENTTEMPLATE — modèles de documents PDF (AcroForm)
// -----------------------------------------------------------------------------
// L'admin upload un PDF avec des champs de formulaire (AcroForm).
// Le système remplit automatiquement les champs avec les données du client.
// Aucune IA : substitution de variables pure.
model DocumentTemplate {
  id          String   @id @default(cuid())
  name        String                           // "Offre de prêt formelle"
  description String?
  filePath    String                           // /uploads/docs/offre-pret-{id}.pdf
  fileName    String                           // nom original du fichier
  level       Int?                             // niveau associé (1-7), null = disponible partout
  fields      String[]   @default([])          // noms des champs AcroForm détectés (auto)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([level, isActive])
}
