// =============================================================================
// Kredix — Schéma Prisma (PostgreSQL)
// =============================================================================
// Stack OSS auto-hébergée sur VPS (standard DEC-005).
// PostgreSQL + Prisma ORM : choix maturité / typage fort / migrations versionnées.
//
// Version 2 (session 11) : extension CRM complète.
//   - LeadStatus réconcilié (7 statuts pipeline) + SequenceExitReason
//   - Lead enrichi du moteur de prospection/relance (J+3/J+6/J+9, 6 sorties)
//   - Agent + AgentMemory (5 agents IA configurables, mémoire éditable)
//   - EmailTemplate (déclencheurs imposés : accusé/offre/relance 1-3/manuel)
//   - EmailGateway (multi-fournisseurs, 1 actif)
//   - SuppressionList (STOP/bounce/plainte — conformité anti-spam, sans IA)
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// ENUMS — Lead & prospection
// -----------------------------------------------------------------------------

/// Cycle de vie d'un lead dans le pipeline commercial (aligné sur le CRM : 7 statuts).
/// Les deux terminaux (client / lost) ferment la séquence de prospection.
enum LeadStatus {
  new         // Nouveau — formulaire rempli (orange)
  contacted   // Contacté — Agent Accueil a accusé réception (bleu clair)
  progress    // En analyse — dossier en traitement (bleu foncé)
  offer       // Offre envoyée (violet)
  waiting     // En relance — dans la file de relance (ambre)
  client      // Client — validé par admin (vert) — TERMINAL POSITIF
  lost        // Sans réponse / Clos — TERMINAL NÉGATIF (rouge)
}

/// Raison de sortie de la séquence de prospection.
/// Alimentée par : validation admin, lien de désinscription (token),
/// webhook fournisseur (bounce/plainte), exclusion manuelle, compteur, horloge.
/// L'IA ne lit JAMAIS les emails entrants — ces sorties sont systémiques.
enum SequenceExitReason {
  validated      // validé client par admin
  unsubscribe    // STOP du prospect (clic lien token)
  bounced        // email invalide (webhook fournisseur)
  complaint      // plainte / bouton spam (webhook fournisseur)
  excluded       // exclusion manuelle admin
  max_relances   // 3 relances atteintes
  timeout        // 10 jours sans validation admin
}

/// Niveau de permission des utilisateurs du back-office.
/// Zitadel gère l'authentification (SSO/OIDC), ce rôle local pilote l'autorisation.
enum AdminRole {
  admin    // accès complet (CMS + paramètres + utilisateurs)
  advisor  // conseiller : gère les leads qui lui sont assignés
  viewer   // lecture seule (reporting / audit)
}

// -----------------------------------------------------------------------------
// ENUMS — Agents IA
// -----------------------------------------------------------------------------

/// Rôles verrouillés des 5 agents IA. Un rôle = un agent (unique).
enum AgentRole {
  accueil   // accusé réception + annonce rappel 48h
  offre     // calcul et envoi de l'offre de prêt formalisée
  relance   // séquence de relance J+3 / J+6 / J+9
  tri       // qualification / priorisation des dossiers entrants
  seo       // audit référencement (lecture seule, suggestions)
}

// -----------------------------------------------------------------------------
// ENUMS — Emails
// -----------------------------------------------------------------------------

/// Déclencheur d'un modèle email. Verrouillé (enum fixe) pour garantir que le
/// job de relance trouve déterministiquement le bon template à chaque étape.
/// L'admin édite le CONTENU, jamais le slot.
enum EmailTrigger {
  reception_ack   // accusé Agent Accueil (J+0, <5 min)
  offer           // offre formalisée (Agent Offre)
  relance_1       // J+3 — IMPOSÉ
  relance_2       // J+6 — IMPOSÉ
  relance_3       // J+9 — IMPOSÉ
  manual          // envoi manuel (changement conseiller, etc.)
  level_1         // Niveau client 1 — Accueil client
  level_2         // Niveau client 2 — Demande documents
  level_3         // Niveau client 3 — Offre de prêt formelle
  level_4         // Niveau client 4 — Vérification dossier
  level_5         // Niveau client 5 — Accord de principe
  level_6         // Niveau client 6 — Signature
  level_7         // Niveau client 7 — Déblocage fonds
}

enum TemplateStatus {
  active
  draft
}

/// Fournisseurs d'envoi email. Un seul `isActive = true` à la fois (contrainte app).
enum GatewayProvider {
  resend
  brevo
  smtp
}

// -----------------------------------------------------------------------------
// ENUMS — Conformité anti-spam
// -----------------------------------------------------------------------------

/// Raison de présence en liste de suppression (ne plus jamais contacter).
enum SuppressionReason {
  unsubscribe   // STOP du prospect (clic lien token)
  bounce        // email invalide (webhook fournisseur)
  complaint     // plainte (bouton spam — webhook fournisseur)
  manual        // exclusion manuelle admin
}

// -----------------------------------------------------------------------------
// LEAD — demande de crédit déposée par un prospect + moteur de prospection
// -----------------------------------------------------------------------------
model Lead {
  id                String     @id @default(cuid())
  firstName         String
  lastName          String
  email             String?    // optionnel : le téléphone reste le canal principal
  phone             String
  city              String
  street            String?    // adresse : numéro + rue
  zipCode           String?    // code postal
  country           String     @default("FR") // code pays (FR, BE, CH, ...)

  // loanType en string (pas enum) : la liste de produits peut s'étendre
  // (véhicule, travaux, étudiant...) sans imposer une migration de schéma.
  loanType          String

  amount            Int        // montant demandé, en devise locale (entier = pas de flottants)
  durationYears     Int

  // Champs pré-calculés par le simulateur (instantané lead au moment de la demande).
  monthlyPayment    Int?       // mensualité estimée en euros
  annualRate        Float?     // taux indicatif en %
  totalCost         Int?       // coût total du crédit en euros

  // Même logique que loanType : situations professionnelles évolutives.
  employmentStatus  String

  // Nom de l'entreprise (pour les prêts pro / entreprise).
  companyName       String?

  status            LeadStatus @default(new)

  preferredLanguage String     @default("fr") // i18n des communications
  whatsappConsent   Boolean    @default(false) // consentement RGPD explicite
  notes             String?    // notes internes conseillers

  // Relation optionnelle : un lead peut ne pas encore être assigné.
  // onDelete: SetNull — si le conseiller est supprimé, le lead revient à
  // "non assigné" (au lieu d'une erreur FK). Le routing/cron peut le réassigner.
  assignedToId      String?
  assignedTo        AdminUser? @relation("AssignedLeads", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedAt        DateTime?    // DEC-K5 : timestamp d'assignation (routing automatique ou manuel)

  // ===== MULTI-ADMIN (DEC-K5) — relations inverse pour scope EmailLog/ClientStep =====
  // Permettent le filtrage relationnel : getEmailLogScope() / getClientStepScope()
  emailLogs         EmailLog[]                     // historique des emails envoyés à ce lead
  clientSteps       ClientStep[]                   // parcours client (7 niveaux)
  trackings         LeadTracking[]                 // étapes de suivi manuel (page suivi client)

  // ===== MOTEUR DE PROSPECTION / RELANCE =====
  // L'Agent Accueil accuse réception (<5 min) puis annonce un rappel 48h.
  // Sans validation client, le lead entre en file de relance (J+3/J+6/J+9).
  // Sorties systémiques (jamais par lecture d'email entrant) :
  //   validation admin · STOP (lien token) · bounce/plainte (webhook fournisseur)
  //   exclusion manuelle · 3 relances · timeout 10 jours.
  ackSentAt         DateTime?    // accusé Agent Accueil envoyé (J+0)
  offerSentAt       DateTime?    // offre de prêt envoyée (T+15min après welcome)
  recallDueAt       DateTime?    // rappel annoncé à 48 h
  sequenceActive    Boolean      @default(false) // dans la file de relance ?
  relanceCount      Int          @default(0)     // 0 → 3
  nextRelanceAt     DateTime?    // J+3 / J+6 / J+9 (prochaine échéance)
  sequenceStartedAt DateTime?
  sequenceEndedAt   DateTime?
  exitReason        SequenceExitReason?          // null tant que la séquence est active

  // ===== DÉSINSCRIPTION PUBLIQUE (sans login) =====
  // Lien pied d'email : /api/unsubscribe?t=<unsubscribeToken>
  // Le prospect clique → route publique → SuppressionList + fermeture séquence.
  unsubscribeToken  String       @unique @default(cuid())
  unsubscribedAt    DateTime?

  // ===== RÉFÉRENCE PUBLIQUE (page suivi client /suivi) =====
  // Format : KREDIX-XXXXXXXX (8 derniers chars du id, majuscules).
  // Nullable pour rétro-compat : leads existants migrés avec ce calcul.
  // Les nouveaux leads l'ont à la création (POST /api/leads).
  reference         String?     @unique

  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  // Accès rapide par statut pour les tableaux de bord / files de traitement.
  @@index([status])
  // Recherche par conseiller + statut = requête la plus fréquente du BO.
  @@index([assignedToId, status])
  // Requête du job de relance : leads actifs dont l'échéance est atteinte.
  @@index([sequenceActive, nextRelanceAt])
  // Reporting des sorties de séquence.
  @@index([exitReason])
}

// -----------------------------------------------------------------------------
// BANKPARTNER — banques comparées sur le site
// -----------------------------------------------------------------------------
model BankPartner {
  id           String   @id @default(cuid())
  name         String   @unique
  slug         String   @unique // stable pour les URLs (pas l'id technique)
  logoUrl      String?
  apiEndpoint  String? // intégration future (webservices bancaires)
  contactEmail String?
  contactPhone String?
  isActive     Boolean  @default(true)
  displayOrder Int      @default(0) // tri CMS-manuel pour la page comparatif

  rates        Rate[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// RATE — taux indicatifs par banque / type de prêt / palier de montant
// -----------------------------------------------------------------------------
model Rate {
  id         String       @id @default(cuid())
  bankId     String?      // nullable : un taux peut exister sans banque (taux générique)
  bank       BankPartner? @relation(fields: [bankId], references: [id])

  loanType   String

  amountMin  Int // palier bas (inclusif)
  amountMax  Int // palier haut (inclusif)

  annualRate Float // taux annuel en % (ex: 4.95)
  isActive   Boolean      @default(true)
  validFrom  DateTime     @default(now()) // date d'entrée en vigueur (historique)

  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  // Un même palier ne peut exister qu'une fois par banque/type : empêche les
  // doublons qui rendraient le comparatif ambigu.
  // NB : en PostgreSQL, les NULL sont considérés comme distincts dans une
  // contrainte unique — l'unicité des taux génériques (bankId NULL) est donc
  // également garantie côté applicative (POST /api/rates).
  @@unique([bankId, loanType, amountMin, amountMax])
  // Recherche des taux applicables pour un type donné (page comparatif).
  @@index([loanType, isActive])
}

// -----------------------------------------------------------------------------
// ADMINUSER — comptes admin CRM (auth NextAuth.js v5 Credentials + bcrypt)
// -----------------------------------------------------------------------------
// NextAuth v5 (DEC-K4) remplace Zitadel. Authentification via Credentials
// Provider + bcrypt. `zitadelSubjectId` conservé nullable pour mémoire
// (si migration future vers IAM externe). `passwordHash` requis pour login.
// `twoFactorSecret` (TOTP base32) nullable — activé individuellement par admin.
model AdminUser {
  id               String       @id @default(cuid())
  email            String       @unique
  displayName      String
  role             AdminRole    @default(advisor)
  isActive         Boolean      @default(true)
  passwordHash     String?      // bcrypt hash (null = login désactivé / externe)
  twoFactorSecret  String?      // TOTP base32 secret (null = 2FA désactivée)
  zitadelSubjectId String?      @unique // legacy Zitadel — nullable depuis DEC-K4
  lastLoginAt      DateTime?

  // ===== MULTI-ADMIN (DEC-K5) — identité conseiller + routing automatique =====
  firstName        String?      // prénom conseiller (variables email {{prenom_conseiller}})
  lastName         String?      // nom conseiller (variables email {{nom_conseiller}})
  phone            String?      // téléphone conseiller (variables email {{telephone_conseiller}})
  loanTypes        String[]     @default([])  // routing : ["immo","pro","conso","rachat"] — VIDE = tous types
  countries        String[]     @default([])  // routing : ["FR","BE","CH"] — VIDE = tous pays
  maxActiveLeads   Int          @default(50)   // plafond de charge (nb leads séquence active)
  currentActiveLeads Int        @default(0)     // dénormalisé pour perf du routing (least-loaded)
  lastAssignedAt   DateTime?    // tie-break du round-robin (le moins récent gagne en cas d'égalité de charge)

  // ===== KRX-007 — Révocation session immédiate (JWT stateless) =====
  // Incrémenté à chaque : changement de mot de passe, désactivation admin,
  // appel à /api/profile/revoke-sessions. Le JWT embarque sessionTokenVersion ;
  // getCurrentAdmin() compare les deux — si différents, le token est révoqué.
  sessionTokenVersion Int       @default(0)

  // Deux relations distinctes sur Lead : l'assignment nominatif
  // ("AssignedLeads") et la collection générique back-referencée.
  leads            Lead[]       @relation("AssignedLeads")
  // (relation inverse Lead.assignedTo)

  // ===== MULTI-ADMIN : ressources possédées (isolation par admin) =====
  gateways         EmailGateway[] @relation("OwnedGateways")
  campaigns        Campaign[]     @relation("OwnedCampaigns")

  // ===== Phase 7 Bloc F — Journaux d'audit (super-admin only) =====
  auditLogs        AuditLog[]
  trackingValidations LeadTracking[]               // étapes tracking validées par cet admin

  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([role, isActive])
}

// -----------------------------------------------------------------------------
// SETTING — paramètres globaux éditables via CMS / Settings
// -----------------------------------------------------------------------------
// Stocké en string : les settings sont hétérogènes (numéro de téléphone,
// booléen, JSON léger). Le parsing/validation est fait côté app selon la clé.
// Catégories : contact, legal, simulator, cms.*, seo.*, ai.*, cadence.
model Setting {
  id          String   @id @default(cuid())
  key         String   @unique // ex: 'whatsapp_number', 'cms_hero_title'
  value       String
  category    String   @default("general") // ex: 'contact', 'cms.hero', 'ai.model'
  description String?
  updatedAt   DateTime @updatedAt
}

// -----------------------------------------------------------------------------
// AGENT — agents IA configurables (5 rôles verrouillés)
// -----------------------------------------------------------------------------
// Le systemPrompt est VERROUILLÉ (non contournable) : il contient le rôle,
// les limites strictes et le bloc SÉCURITÉ. L'admin ne peut pas le modifier —
// il ne fait qu'éditer la mémoire (AgentMemory) et les outils/garde-fous.
model Agent {
  id            String     @id @default(cuid())
  role          AgentRole  @unique           // 5 rôles verrouillés (un agent par rôle)
  name          String                       // "Agent Accueil"
  initials      String                       // "AA" (avatar CRM)
  description   String                       // sous-rôle affiché
  isActive      Boolean    @default(true)
  systemPrompt  String     @db.Text          // VERROUILLÉ (rôle + SÉCURITÉ)
  // tools : liste blanche d'outils par agent (on/off + description).
  // JSON car lecture groupée + toggles UI ; structure stable côté app.
  tools         Json       @default("{}")    // ex: { "read_dossier": {on:true, desc:"Lecture seule"} }
  // guardrails : limites appliquées automatiquement (debit_max, escalade_si...).
  guardrails    Json       @default("{}")    // ex: { "debit_max": "50 emails/heure" }
  memories      AgentMemory[]

  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

// -----------------------------------------------------------------------------
// AGENTMEMORY — fichier mémoire éditable clé/valeur (par agent)
// -----------------------------------------------------------------------------
// Édité INLINE depuis l'admin (add/modify/delete clé par clé).
// Sous-modèle (pas JSON) : CRUD individuel propre + queryable.
model AgentMemory {
  id        String  @id @default(cuid())
  agentId   String
  agent     Agent   @relation(fields: [agentId], references: [id], onDelete: Cascade)
  key       String                     // delai_rappel, arguments_cles, canal_prefere...
  value     String  @db.Text           // valeur éditable (texte libre)
  @@index([agentId])
}

// -----------------------------------------------------------------------------
// EMAILTEMPLATE — modèles d'emails (déclencheurs imposés)
// -----------------------------------------------------------------------------
// 6 slots fixes (reception_ack, offer, relance_1/2/3, manual).
// Contrainte app : UN seul template `active` par trigger (vérifié au save).
// Le job de relance trouve déterministiquement le template de chaque étape.
model EmailTemplate {
  id            String         @id @default(cuid())
  name          String                          // "Accusé de réception (DE)"
  trigger       EmailTrigger                    // slot fixe (pilote l'affectation auto)
  language      String         @default("fr")   // langue du contenu (fr, de, en, es, pt, it)
  agentId       String?                         // agent émetteur (optionnel, info)
  status        TemplateStatus @default(draft)  // active / draft
  subject       String         @db.Text         // objet avec variables {{Prénom}}
  bodyText      String         @db.Text         // éditeur visuel (texte + variables)
  htmlContent   String?        @db.Text         // HTML sérialisé (éditeur blocs ou import)
  blocksJson    String?        @db.Text         // JSON des blocs éditeur visuel (pour réédition)
  bannerEnabled Boolean        @default(true)   // bannière Kredix en en-tête
  isConfidential Boolean       @default(false)  // verrouillé : l'IA ne peut ni lire, ni modifier, ni supprimer
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  campaigns       Campaign[]
  pipelineSteps   PipelineStep[] @relation("PipelineStepTemplate")

  @@index([trigger, status, language])   // un seul actif par trigger + langue
}

// -----------------------------------------------------------------------------
// EMAILGATEWAY — passerelles d'envoi (multi-fournisseurs, 1 actif)
// -----------------------------------------------------------------------------
// L'admin configure chaque fournisseur ; UN seul isActive à la fois.
// apiKey : secret — JAMAIS exposé côté client (serveur uniquement).
// config : hôte SMTP, domaine, mode API/SMTP, identifiant (JSON selon provider).
model EmailGateway {
  id          String           @id @default(cuid())
  provider    GatewayProvider
  label       String                          // "Resend", "SMTP Hostinger"
  apiKey      String?                          // secret — usage serveur uniquement
  config      Json             @default("{}") // domaine, hôte, mode, identifiant
  isActive    Boolean          @default(false) // actif (plusieurs peuvent l'être)
  isPrimary   Boolean          @default(false) // SMTP principal pour prospects/relances (UN SEUL PAR ADMIN désormais — DEC-K5)

  // ===== MULTI-ADMIN (DEC-K5) — SMTP exclusif par admin =====
  // onDelete: SetNull — si l'owner est supprimé, le SMTP devient système (ownerId=null).
  ownerId     String?                          // null = SMTP système (fallback pour leads unassigned)
  owner       AdminUser?       @relation("OwnedGateways", fields: [ownerId], references: [id], onDelete: SetNull)
  isSystem    Boolean          @default(false) // true = SMTP système réservé aux leads unassigned (un seul actif)

  createdAt   DateTime         @default(now())
  updatedAt   DateTime @updatedAt

  campaigns   Campaign[]

  @@index([provider])
  @@index([isActive])
  @@index([ownerId, isActive])   // perf filtrage scope admin (conseiller voit SES SMTP)
}

// -----------------------------------------------------------------------------
// SUPPRESSIONLIST — ne plus jamais contacter (conformité anti-spam)
// -----------------------------------------------------------------------------
// Alimentée SANS lecture d'email entrant :
//   - lien de désinscription token (GET /api/unsubscribe?t=...)
//   - webhook fournisseur (POST /api/webhooks/email — bounce/complaint)
//   - exclusion manuelle admin
// Couvre le cas récurrent : même email, plusieurs leads dans le temps.
model SuppressionList {
  id        String             @id @default(cuid())
  email     String
  reason    SuppressionReason
  leadId    String?                              // lead à l'origine (traçabilité)
  createdAt DateTime           @default(now())

  @@unique([email])            // un email = une entrée (raison la plus récente)
  @@index([reason])
}

// -----------------------------------------------------------------------------
// LEGALPAGE — pages légales éditables depuis le CMS (CGU, mentions, RGPD...)
// -----------------------------------------------------------------------------
// Contenu long structuré avec sa propre route frontend /[locale]/legal/[slug].
// L'admin édite le contenu HTML via un éditeur riche dans le CRM.
model LegalPage {
  id        String   @id @default(cuid())
  slug      String   @unique    // "cgu", "mentions-legales", "politique-confidentialite"
  locale    String   @default("de") // "de" | "fr" | "en" | ...
  title     String               // "Conditions Générales d'Utilisation"
  category  String               // "legal" | "privacy" | "terms"
  content   String   @db.Text    // contenu HTML (éditeur riche)
  order     Int      @default(0) // ordre d'affichage dans le footer
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([category, isActive])
  @@index([locale, isActive])
  @@index([order])
}

// -----------------------------------------------------------------------------
// CAMPAIGN — campagne d'envoi en masse (broadcast)
// -----------------------------------------------------------------------------
// L'admin crée une campagne (template + destinataires), puis déclenche l'envoi.
// Le traitement est asynchrone : 1 email → pause 30-90s → suivant → ...
// Respecte les garde-fous cadence (daily cap, intervalle, SuppressionList).
model Campaign {
  id              String         @id @default(cuid())
  name            String                          // "Offre spéciale été"
  templateId      String
  template        EmailTemplate  @relation(fields: [templateId], references: [id])
  gatewayId       String?                         // SMTP spécifique pour cette campagne (null = primary de l'owner)
  gateway         EmailGateway?  @relation(fields: [gatewayId], references: [id])
  domainId        String?                         // domaine d'envoi (FK Domain type=mail), null = global from_email
  domain          Domain?        @relation(fields: [domainId], references: [id])

  // ===== MULTI-ADMIN (DEC-K5) — propriétaire de la campagne =====
  // onDelete: SetNull — si l'owner est supprimé, la campagne revient au super-admin (ownerId=null).
  ownerId         String?                         // null = legacy / super-admin (tous voient)
  owner           AdminUser?     @relation("OwnedCampaigns", fields: [ownerId], references: [id], onDelete: SetNull)

  status          CampaignStatus @default(draft)
  recipientSource String                          // "validated_today" | "validated_week" | "manual" | "all_active"
  totalRecipients Int            @default(0)
  sentCount       Int            @default(0)
  failedCount     Int            @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  recipients      CampaignRecipient[]

  @@index([status])
  @@index([createdAt])
  @@index([ownerId])   // perf filtrage scope admin
}

model CampaignRecipient {
  id          String                  @id @default(cuid())
  campaignId  String
  campaign    Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  leadId      String?
  email       String
  firstName   String?
  lastName    String?
  phone       String?
  source      String                  @default("lead")  // "lead" | "import"
  status      CampaignRecipientStatus @default(pending)
  sentAt      DateTime?
  error       String?

  @@index([campaignId, status])
}

enum CampaignStatus {
  draft       // créée, pas encore envoyée
  sending     // envoi en cours (processus async)
  completed   // terminée (tous les destinataires traités)
  cancelled   // annulée par l'admin
  failed      // erreur fatale
}

enum CampaignRecipientStatus {
  pending   // en attente d'envoi
  sending   // verrouillé par un worker (anti double-envoi atomique)
  sent      // envoyé avec succès
  failed    // échec d'envoi (erreur gateway)
  skipped   // ignoré (suppression list, pas d'email)
}

// -----------------------------------------------------------------------------
// EMAILLOG — historique de tous les emails envoyés à un prospect
// -----------------------------------------------------------------------------
// Trace chaque envoi (accueil, offre, relance, campagne) pour audit + vue Historique.
//
// Champs gateway* (snapshot) — ajouté pour traçabilité du SMTP utilisé par envoi.
// Pas de FK : snapshot immuable (préserve l'historique si le gateway est supprimé).
// Cohérent avec le pattern existant (email, templateName, subject sont déjà des snapshots).
model EmailLog {
  id           String   @id @default(cuid())
  leadId       String?                          // null si pas lié à un lead (campaign sans lead)
  lead         Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  email        String                           // snapshot email au moment de l'envoi
  trigger      String                           // "accueil_ack" | "offer" | "relance_1" | "relance_2" | "relance_3" | "campaign" | "manual"
  templateName String                           // "Accusé de réception" (snapshot du nom au moment de l'envoi)
  subject      String         @db.Text          // objet envoyé (après interpolation ou génération IA)
  bodyText     String?        @db.Text          // corps envoyé (snapshot — pour historique communication et contexte IA)
  campaignId   String?                          // si lié à une campagne
  status       String         @default("sent")  // "sent" | "failed" | "skipped"
  error        String?
  sentAt       DateTime       @default(now())

  // ===== SNAPSHOT GATEWAY (traçabilité SMTP utilisé — DEC-K5 multi-admin) =====
  gatewayId    String?                          // snapshot id du gateway utilisé (pas de FK)
  gatewayLabel String?                          // snapshot "SMTP Hostinger" / "Resend"
  fromEmail    String?                          // snapshot "mail@kredix.fr" (config.from)

  @@index([leadId, sentAt])
  @@index([email, sentAt])
  @@index([trigger])
  @@index([gatewayId])
}

// -----------------------------------------------------------------------------
// DOMAIN — multi-domaines / multi-marques
// -----------------------------------------------------------------------------
// Permet de configurer plusieurs domaines pour des usages spécifiques :
// site public, admin CRM, envoi d'emails, ou marque blanche.
model Domain {
  id          String   @id @default(cuid())
  domain      String   @unique                 // "kredix.fr", "crm.kredix.fr", "moncredit.fr"
  type        DomainType @default(site)
  brandName   String?                           // nom de marque affiché (null = utiliser site_name)
  logoUrl     String?                           // logo spécifique à ce domaine
  primaryColor String?                          // couleur principale (hex), null = défaut
  fromEmail   String?                           // adresse d'envoi pour ce domaine (ex: "noreply@kredix.fr")
  spfRecord   String?                           // enregistrement SPF configuré (informatif)
  dkimRecord  String?                           // enregistrement DKIM configuré (informatif)
  dmarcRecord String?                           // enregistrement DMARC configuré (informatif)
  isActive    Boolean  @default(true)
  isPrimary   Boolean  @default(false)          // un seul primaire par type
  sslStatus   String   @default("pending")      // "pending" | "active" | "error"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns   Campaign[]

  @@index([type, isActive])
}

enum DomainType {
  site     // site public principal
  admin    // interface admin CRM
  mail     // domaine d'envoi d'emails (SPF/DKIM/DMARC)
  brand    // marque blanche / domaine secondaire
}

// -----------------------------------------------------------------------------
// CLIENTSTEP — progression du client dans les 7 niveaux d'accompagnement
// -----------------------------------------------------------------------------
// Quand un prospect est validé comme client, il entre dans le parcours 7 niveaux.
// Chaque niveau déclenche l'envoi d'un email (template level_N) + PDFs associés.
model ClientStep {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  level       Int                             // ordre du PipelineStep au moment de l'envoi (backward compat)
  stepId      String?                         // FK vers PipelineStep (nullable = niveau legacy)
  step        PipelineStep?                   @relation(fields: [stepId], references: [id], onDelete: SetNull)
  templateId  String                          // template email envoyé à ce niveau
  emailLogId  String?                         // lien vers EmailLog
  sentAt      DateTime @default(now())

  @@unique([leadId, level])  // un seul envoi par niveau par client
  @@index([leadId])
}

// -----------------------------------------------------------------------------
// DOCUMENTTEMPLATE — modèles de documents PDF (AcroForm)
// -----------------------------------------------------------------------------
// L'admin upload un PDF avec des champs de formulaire (AcroForm).
// Le système remplit automatiquement les champs avec les données du client.
// Aucune IA : substitution de variables pure.
model DocumentTemplate {
  id          String   @id @default(cuid())
  name        String                           // "Offre de prêt formelle"
  description String?
  filePath    String                           // /uploads/docs/offre-pret-{id}.pdf
  fileName    String                           // nom original du fichier
  level       Int?                             // niveau associé (1-7), null = disponible partout
  fields      String[]   @default([])          // noms des champs AcroForm détectés (auto)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  pipelineSteps PipelineStep[] @relation("PipelineStepDocument")

  @@index([level, isActive])
}

// -----------------------------------------------------------------------------
// PIPELINESTEP — étapes configurables du parcours client
// -----------------------------------------------------------------------------
// Remplace l'ancien système hardcoded de 7 niveaux (EmailTrigger.level_1..7).
// L'admin peut : ajouter, supprimer, réordonner, activer/désactiver des étapes.
// Chaque étape associe UN template email + UN document PDF (optionnel).
// L'envoi est 100% manuel (clic admin) — AUCUN délai automatique.
model PipelineStep {
  id            String            @id @default(cuid())
  order         Int                                // position dans le parcours (1, 2, 3...)
  name          String                             // "Accueil client"
  description   String?                            // court résumé affiché dans l'UI
  templateId    String?                            // EmailTemplate utilisé pour ce niveau
  documentId    String?                            // DocumentTemplate (PDF) attaché
  isActive      Boolean           @default(true)   // désactivé = masqué dans la liste d'envoi
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  template      EmailTemplate?    @relation("PipelineStepTemplate", fields: [templateId], references: [id], onDelete: SetNull)
  document      DocumentTemplate? @relation("PipelineStepDocument", fields: [documentId], references: [id], onDelete: SetNull)
  clientSteps   ClientStep[]

  @@index([order])
}

// -----------------------------------------------------------------------------
// TRACKINGSTEP — Étapes de suivi dossier (manuelles, INDÉPENDANTES du pipeline email)
// -----------------------------------------------------------------------------
// Système de suivi public : le conseiller valide manuellement chaque étape
// du dossier client. AUCUNE envoi d'email — purement affichage page /suivi.
// Indépendant de PipelineStep (qui gère les envois d'emails automatiques).
// Configurable par le super-admin dans le menu CRM "Suivi dossier".
model TrackingStep {
  id          String   @id @default(cuid())
  order       Int                                // position dans le parcours (1, 2, 3...)
  name        String                             // "Dossier reçu"
  description String?                            // court texte affiché au client sur la page /suivi
  icon        String?                            // nom d'icône lucide-react optionnel (ex: "check-circle")
  isActive    Boolean  @default(true)            // désactivé = masqué côté admin ET page suivi
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leadTrackings LeadTracking[]

  @@index([isActive, order])
}

// -----------------------------------------------------------------------------
// LEADTRACKING — Validation d'une étape TrackingStep pour un lead donné
// -----------------------------------------------------------------------------
// Une entrée = une étape validée pour un lead (pas de doublon possible).
// AUCUNE envoi d'email — purement marquage manuel déclenché par le conseiller.
// Visible côté client via la page /suivi (endpoint public /api/public/track).
//
// Rôles (Q7) : validation par le conseiller assigné au lead OU super-admin.
// Dévalidation (Q9) : le validateur peut dévalider sa propre validation,
//                    le super-admin peut dévalider n'importe laquelle.
model LeadTracking {
  id              String        @id @default(cuid())
  leadId          String
  lead            Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  trackingStepId  String
  trackingStep    TrackingStep  @relation(fields: [trackingStepId], references: [id], onDelete: Cascade)
  validatedById   String?                              // FK AdminUser (qui a validé)
  validatedBy     AdminUser?    @relation(fields: [validatedById], references: [id], onDelete: SetNull)
  validatedAt     DateTime      @default(now())
  note            String?                              // note interne (jamais affichée au client)

  @@unique([leadId, trackingStepId])                  // 1 validation par étape par lead
  @@index([leadId])
}

// -----------------------------------------------------------------------------
// NOTIFICATION — notifications temps réel du back-office (cloche Topbar)
// -----------------------------------------------------------------------------
// Alimentée par les événements métier (nouveau lead, bounce, conversion client,
// échec email, séquence terminée...). Le helper createNotification() filtre
// selon les préférences notif_* de l'admin avant d'insérer.
//
// Broadcast : recipientId = null → visible par tous les admins.
// readAt globale (null = non lue). Chaque admin voit l'état partagé — suffisant
// pour un CRM avec peu d'utilisateurs back-office.
model Notification {
  id              String    @id @default(cuid())
  type            String                        // 'new_prospect' | 'client_converted' | 'bounce' | 'email_failed' | 'sequence_timeout' | 'sequence_max_relances' | 'agent_activity'
  severity        String    @default("info")    // 'info' | 'success' | 'warning' | 'danger'
  icon            String    @default("info")    // clé Icon.tsx : user-plus, check-circle, alert-triangle, bot, mail, etc.
  title           String                        // "Nouveau prospect"
  message         String    @db.Text            // "Marie Dupont a soumis une demande de 210 000€"
  linkUrl         String?                       // "/leads/clxxx..." pour navigation au clic
  relatedEntityId String?                       // leadId / campaignId (traçabilité)
  recipientId     String?                       // null = broadcast (tous les admins voient)
  readAt          DateTime?                     // null = non lue
  createdAt       DateTime  @default(now())

  @@index([recipientId, readAt])
  @@index([createdAt])
}

// -----------------------------------------------------------------------------
// TESTIMONIAL — avis & témoignages clients affichés sur la landing page.
// -----------------------------------------------------------------------------
// L'admin crée/modifie/supprime des témoignages depuis le CRM.
// Chaque témoignage est associé à une locale (DE par défaut, FR, EN...).
// `isVisible` contrôle l'affichage public, `order` l'ordre d'affichage.
model Testimonial {
  id             String   @id @default(cuid())
  authorName     String                     // "Marie Dupont"
  authorRole     String?                    // "Salariée CDI"
  authorLocation String?                    // "Lyon"
  authorAvatar   String?                    // URL photo/avatar (optionnel)
  rating         Int      @default(5)       // 1-5 étoiles
  content        String   @db.Text          // texte du témoignage
  locale         String   @default("de")    // langue du témoignage
  isVisible      Boolean  @default(true)    // affiché sur la landing ?
  order          Int      @default(0)       // ordre d'affichage
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([locale, isVisible, order])
}

// -----------------------------------------------------------------------------
// CONTENTBLOCK — sections de contenu éditables depuis le CMS (générique).
// -----------------------------------------------------------------------------
// Une seule table pour toutes les sections éditables de la landing :
//   - section = "engagements"  → "Nos engagements" (cartes pledge)
//   - section = "services"     → "Nos services" (cartes services)
//   - futures sections éditables (avantages, process, FAQ...)
// `items` est un JSON : [{icon, title, description}] — flexible et typé côté app.
// Une entrée par (section, locale) : l'admin édite indépendamment DE/FR/EN...
model ContentBlock {
  id        String   @id @default(cuid())
  section   String                     // "engagements" | "services" | ...
  locale    String   @default("de")    // langue du contenu
  eyebrow   String?                    // sur-titre optionnel (override i18n)
  title     String?                    // titre optionnel (override i18n)
  lead      String?                    // sous-titre optionnel (override i18n)
  items     Json                       // [{icon, title, description}]
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@unique([section, locale])           // 1 block par section/locale
  @@index([section, locale])
}

// -----------------------------------------------------------------------------
// LOANTYPE — Types de prêt configurables (DEC-K5 dynamique).
// -----------------------------------------------------------------------------
// Le super-admin peut créer/modifier/désactiver des types de prêt depuis le CRM.
// Ces types s'affichent dynamiquement dans le formulaire public (site web),
// dans le routing des conseillers (loanTypes) et dans l'admin.
//
// La colonne Lead.loanType reste un String libre — la table LoanType est le
// catalogue des types ACTIFS affichés dans les UI.
// -----------------------------------------------------------------------------

model LoanType {
  id        String   @id @default(cuid())
  code      String   @unique             // clé technique ("immo", "personnel"...)
  label     String                       // libellé affiché ("Immobilier", "Personnel"...)
  isActive  Boolean  @default(true)       // si false → masqué des formulaires
  sortOrder Int      @default(0)          // ordre d'affichage
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// -----------------------------------------------------------------------------
// AUDITLOG — Journal d'audit des actions admin (Phase 7 Bloc F).
// -----------------------------------------------------------------------------
// Trace TOUTE mutation d'une entité métier par un admin (create/update/delete)
// + actions de sécurité (login, logout, reset mdp, révocation session, etc.).
// `diff` contient le delta avant/après (JSON), `metadata` le contexte (IP, UA).
// Vue dédiée "Journal d'audit" (super-admin only).
//
// `adminId` nullable : null = action système (cron, webhook) — pas un humain.
// `entityId` nullable : null si action globale (ex : "export leads").
// `onDelete: SetNull` sur admin : si l'admin est supprimé, ses logs restent
// (traçabilité préservée) mais adminId passe à null.
// -----------------------------------------------------------------------------
model AuditLog {
  id          String     @id @default(cuid())
  adminId     String?
  admin       AdminUser? @relation(fields: [adminId], references: [id], onDelete: SetNull)
  action      String                       // "create" | "update" | "delete" | "login" | "logout" | "password_change" | "session_revoke" | "export" | ...
  entity      String                       // "Lead" | "Campaign" | "AdminUser" | "EmailTemplate" | "Setting" | "EmailGateway" | ...
  entityId    String?                      // ID de l'entité (null si action globale)
  diff        Json?                        // delta avant/après (optionnel)
  metadata    Json?                        // contexte additionnel (IP, user-agent, raison, etc.)
  ipAddress   String?                      // IP de l'auteur (si applicable)
  createdAt   DateTime   @default(now())

  @@index([entity, entityId])
  @@index([adminId])
  @@index([createdAt])
  @@index([action])
}
