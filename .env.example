# =============================================================================
# Kredix — Variables d'environnement (exemple)
# Copier en .env et remplir les valeurs réelles.
# Générer les secrets avec : openssl rand -base64 32
# =============================================================================

# ----- App -----
NODE_ENV=development
# URL publique du site web (apps/web) — utilisée dans les emails, sitemap, etc.
NEXT_PUBLIC_APP_URL=http://localhost:3100
# URL publique du CRM admin (apps/admin) — build-time (Next.js inline).
NEXT_PUBLIC_ADMIN_URL=http://localhost:3200
# URL canonique du site (robots.ts, sitemap.ts, hreflang, email links).
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# ----- Domaines (production Caddy) -----
# Site principal : ex kredix.fr
DOMAIN=kredix.local
# Sous-domaine admin : ex crm.kredix.fr
ADMIN_DOMAIN=admin.kredix.local

# ----- Base de données -----
DATABASE_URL=postgresql://kredix:kredix@localhost:5432/kredix?schema=public
POSTGRES_USER=kredix
POSTGRES_PASSWORD=changer-en-production
POSTGRES_DB=kredix

# ----- Authentification -----
# Secret de session NextAuth / next-auth ( openssl rand -base64 32 ).
AUTH_SECRET=changer-en-production-generer-avec-openssl-rand-base64-32

# Clé dédiée au chiffrement des secrets au repos (2FA TOTP, etc.).
# Indépendante de AUTH_SECRET pour permettre la rotation de AUTH_SECRET sans
# casser le déchiffrement des secrets en DB.
# En prod : OBLIGATOIRE ( openssl rand -base64 32 ).
# Si absente : fallback sur AUTH_SECRET (backward-compat, non recommandé).
ENCRYPTION_KEY=

# ----- Sécurité API (secrets Bearer) -----
# Protect /api/cron/* (Bearer token vérifié en timing-safe par verifyBearerSecret).
CRON_SECRET=
# Protect /api/webhooks/email (Bearer token vérifié en timing-safe).
WEBHOOK_EMAIL_SECRET=

# Reverse proxy : mettre "true" en production derrière Caddy/Nginx.
# Permet à getClientIp() de lire x-forwarded-for (rate limiting, audit).
TRUST_PROXY=false

# ----- Email (transactionnel) -----
# IMPORTANT : La config SMTP se fait via l'admin CMS (Gateways), pas via .env.
# Les vars SMTP_* ci-dessous NE SONT PAS LUES par le code runtime.
# Elles sont conservées uniquement pour référence / scripts de maintenance.
# Configuration réelle : Admin → Paramètres → Passerelles email → Activer.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Kredix <noreply@kredix.fr>"

# ----- WhatsApp Business API — à configurer plus tard
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_ID=

# ----- Observabilité -----
# Niveaux : trace | debug | info | warn | error
LOG_LEVEL=debug

# ----- Production : reverse proxy Caddy -----
# Email utilisée pour les certificats Let's Encrypt.
ACME_EMAIL=admin@kredix.fr

# =============================================================================
# CRON — Relance automatique (J+3 / J+6 / J+9)
# =============================================================================
# En production, déclencher le cron via une tâche cron sur le VPS hôte :
#
#   # Crontab VPS (/etc/cron.d/kredix-relance) :
#   # Tous les jours à 09h00 — relance les leads dus
#   0 9 * * * curl -fsS -X POST \
#     -H "Authorization: Bearer $CRON_SECRET" \
#     https://crm.kredix.fr/api/cron/relance >> /var/log/kredix-cron.log 2>&1
#
# $CRON_SECRET doit correspondre à la valeur du .env du conteneur admin.
# =============================================================================
