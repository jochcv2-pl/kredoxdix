{
  "name": "kredix",
  "private": true,
  "version": "0.1.0",
  "description": "Kredix — Courtier en financement. Compare 40 banques pour le meilleur taux.",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "clean": "turbo clean && rimraf node_modules",
    "db:generate": "pnpm --filter @kredix/db db:generate",
    "db:migrate": "pnpm --filter @kredix/db db:migrate",
    "db:push": "pnpm --filter @kredix/db db:push",
    "db:studio": "pnpm --filter @kredix/db db:studio",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report tests/e2e-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "otplib": "^13.4.1",
    "rimraf": "^6.0.0",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  }
}
