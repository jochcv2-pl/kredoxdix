# A-002 : pnpm 11 sur Windows lance un "deps status check" avant chaque commande
# qui réécrit pnpm-workspace.yaml. Si un process tient le fichier → EPERM.
verify-deps-before-run=false

# A-008 : réseau potentiellement lent, on augmente les retries et le timeout
fetch-retries=8
fetch-timeout=600000
network-concurrency=2

# Préserver les liens symboliques (meilleur comportement Windows)
node-linker=isolated

# Ne pas avertir sur les builds ignorés (gérés via onlyBuiltDependencies dans workspace.yaml)
strict-peer-dependencies=false
