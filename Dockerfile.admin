# =============================================================================
# Kredix — Dockerfile.admin (apps/admin, le CRM)
# Miroir du Dockerfile principal (apps/web) mais pour apps/admin sur le port 3001.
# Les stages base/deps/builder sont identiques ; seul le runner diffère (path + port).
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1 — base (identique au Dockerfile web)
# -----------------------------------------------------------------------------
FROM node:22-alpine AS base
# Node 22 requis : pnpm 11.9 utilise des builtin modules non disponibles sur Node 20.
RUN apk add --no-cache libc6-compat \
    && corepack enable \
    && corepack prepare pnpm@11.9.0 --activate
WORKDIR /app

# -----------------------------------------------------------------------------
# Stage 2 — deps (identique au Dockerfile web)
# -----------------------------------------------------------------------------
FROM base AS deps
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml turbo.json tsconfig.base.json ./
COPY apps ./apps
COPY packages ./packages
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    PNPM_CONFIG_FETCH_TIMEOUT=600000 \
    PNPM_CONFIG_FETCH_RETRIES=8 \
    pnpm install --frozen-lockfile

# -----------------------------------------------------------------------------
# Stage 3 — builder (identique au Dockerfile web, turbo build tout le monorepo)
# -----------------------------------------------------------------------------
FROM base AS builder
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps ./apps
COPY --from=deps /app/packages ./packages
COPY package.json pnpm-workspace.yaml turbo.json tsconfig.base.json ./
ARG NEXT_PUBLIC_APP_URL=http://localhost:3200
ENV NEXT_PUBLIC_APP_URL=${NEXT_PUBLIC_APP_URL}
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production
RUN pnpm --filter @kredix/db db:generate
RUN pnpm build

# Copie des fonts pdfkit (.afm) vers un chemin fixe.
# Ces fichiers sont chargés dynamiquement par pdfkit au runtime et ne sont
# PAS tracés par Next.js standalone → ENOENT en production Docker.
# DEPUIS s53 : les 4 Helvetica .afm sont COMMITÉES dans le repo
# (apps/admin/resources/pdfkit-data/) — copie déterministe, indépendante du
# layout pnpm. Le find sur node_modules reste en secours (autres fonts).
COPY apps/admin/resources/pdfkit-data/ /app/pdfkit-data/
RUN ls /app/pdfkit-data/ | head -5 \
    && find /app/node_modules -path "*/pdfkit/js/data" -type d \
       -exec sh -c 'cp -n "$1"/* /app/pdfkit-data/ 2>/dev/null || true' _ {} \; \
    && echo "pdfkit fonts copied: $(ls /app/pdfkit-data/ | wc -l) files"

# -----------------------------------------------------------------------------
# Stage 4 — runner (apps/admin, port 3001)
# -----------------------------------------------------------------------------
FROM node:22-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs \
    && adduser --system --uid 1001 nextjs

# Copie du build standalone apps/admin.
# Avec outputFileTracingRoot, standalone préserve la structure monorepo :
# standalone/apps/admin/server.js + standalone/node_modules/
COPY --from=builder --chown=nextjs:nodejs /app/apps/admin/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/admin/.next/static ./apps/admin/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/admin/public ./apps/admin/public

# Fonts pdfkit (.afm) — copiées depuis le builder (chemin fixe /app/pdfkit-data)
COPY --from=builder --chown=nextjs:nodejs /app/pdfkit-data /app/pdfkit-data

# Crée le dossier uploads avec les bonnes permissions pour le volume partagé.
# Docker copie ces permissions dans le named volume lors du premier montage.
RUN mkdir -p /app/apps/admin/public/uploads && chown nextjs:nodejs /app/apps/admin/public/uploads

USER nextjs
EXPOSE 3001
ENV PORT=3001
ENV HOSTNAME="0.0.0.0"

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://localhost:3001/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "apps/admin/server.js"]
